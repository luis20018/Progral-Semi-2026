<%@ Application Language="C#" %><script runat="server">void Application_AcquireRequestState(object sender,EventArgs e){var ruta=System.IO.Path.GetFileName(Request.Path).ToLowerInvariant();if(!ruta.EndsWith(".aspx")&&!ruta.EndsWith(".ashx"))return;Response.Cache.SetCacheability(HttpCacheability.NoCache);Response.Cache.SetNoStore();if(ruta=="login.aspx"||ruta=="registro.aspx"||ruta=="salir.aspx")return;if(!Context.User.Identity.IsAuthenticated)return;if(Session==null||!string.Equals(Session["AccesoValidado"] as string,Context.User.Identity.Name,StringComparison.OrdinalIgnoreCase)){System.Web.Security.FormsAuthentication.SignOut();Response.Redirect("~/Login.aspx",true);return;}var rol=Datos.RolActual();if(rol=="Administrador")return;if((rol=="Cliente"||rol=="Barbero")&&ruta=="miportal.aspx")return;if(ruta=="default.aspx"&&(rol=="Cliente"||rol=="Barbero"))Response.Redirect("MiPortal.aspx",true);Response.StatusCode=403;Response.End();}</script>