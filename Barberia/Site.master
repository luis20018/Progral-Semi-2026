<%@ Master Language="C#" %><!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Barbería</title><link rel="stylesheet" href="estilo.css"/></head><body><form runat="server"><aside><div class="brand"><span class="brand-icon">✂</span><div>BARBERÍA<small>GESTIÓN PROFESIONAL</small></div></div><% if (Datos.EsDueno()) { %><div class="nav-label">MENÚ PRINCIPAL</div><a href="Default.aspx">Inicio / Panel principal</a><a href="Gestion.aspx?t=Clientes">Registrar cliente</a><a href="Agenda.aspx">Agenda de citas</a><a href="Gestion.aspx?t=Servicios">Servicios</a><a href="Informes.aspx">Informes</a><a href="Gestion.aspx?t=Empleados">Empleados</a><a href="Gestion.aspx?t=Recordatorios">Recordatorios</a><details><summary>Configuración</summary><a href="Accesos.aspx">Cuentas de acceso</a><a href="Gestion.aspx?t=Horarios">Horarios</a><a href="Operaciones.aspx?m=cita">Editar citas</a><a href="Operaciones.aspx?m=factura">Editar facturas</a><a href="Operaciones.aspx?m=pago">Editar pagos</a><a href="Facturacion.aspx">Facturación</a><a href="Cobros.aspx">Pagos</a><a href="Gestion.aspx?t=Productos">Inventario</a><a href="Gestion.aspx?t=Movimientos">Movimientos</a><a href="Gestion.aspx?t=MetodosPago">Métodos de pago</a><a href="Gestion.aspx?t=DetalleCita">Detalle de citas</a><a href="Gestion.aspx?t=DetalleFactura">Detalle de facturas</a><a href="Sugerencias.aspx">Recomendaciones</a></details><% } else { %><a href="MiPortal.aspx"><%= Datos.RolActual()=="Cliente" ? "Agendar cita" : "Mis citas" %></a><% } %><div class="logout"><a href="Salir.aspx">Cerrar sesión</a></div></aside><main><header class="topbar"><span>BARBERÍA / ADMINISTRACIÓN</span><span><%= Server.HtmlEncode(Datos.EsDueno()?"Dueño":Datos.RolActual()) %></span></header><asp:ContentPlaceHolder ID="Contenido" runat="server"/></main></form></body></html>