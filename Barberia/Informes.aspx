<%@ Page Language="C#" Inherits="PaginaBase" MasterPageFile="~/Site.master" %><script runat="server">
protected void Page_Load(object s, EventArgs e) {
string[] consultas = new string[] {"SELECT Id,Nombre,Apellido,Telefono,Correo FROM Clientes","SELECT Nombre,Apellido,Especialidad FROM Empleados WHERE Activo=1","SELECT Nombre,Precio,DuracionMin FROM Servicios WHERE Activo=1","SELECT c.Id,cl.Nombre,e.Nombre AS Empleado,c.Hora,c.Estado FROM Citas c JOIN Clientes cl ON cl.Id=c.Cliente JOIN Empleados e ON e.Id=c.Empleado WHERE c.Fecha=CAST(GETDATE() AS date)","SELECT * FROM Citas WHERE Estado='Cancelada'","SELECT * FROM Citas WHERE Estado='Realizada'","SELECT Fecha,SUM(Monto) AS Total FROM Pagos GROUP BY Fecha ORDER BY Fecha DESC","SELECT YEAR(Fecha) AS Anio,MONTH(Fecha) AS Mes,SUM(Monto) AS Total FROM Pagos GROUP BY YEAR(Fecha),MONTH(Fecha)","SELECT s.Nombre,SUM(d.Cantidad) AS Cantidad FROM DetalleCita d JOIN Servicios s ON s.Id=d.Servicio GROUP BY s.Nombre ORDER BY Cantidad DESC","SELECT p.Nombre,p.StockMinimo,COALESCE(SUM(CASE WHEN m.Tipo='Entrada' THEN m.Cantidad WHEN m.Tipo='Salida' THEN -m.Cantidad ELSE 0 END),0) AS Existencia FROM Productos p LEFT JOIN Movimientos m ON m.Producto=p.Id GROUP BY p.Nombre,p.StockMinimo HAVING COALESCE(SUM(CASE WHEN m.Tipo='Entrada' THEN m.Cantidad WHEN m.Tipo='Salida' THEN -m.Cantidad ELSE 0 END),0)<=p.StockMinimo"};
lista.DataSource=Tabla(consultas[Convert.ToInt32(opcion.SelectedValue)]);
lista.DataBind();
}
</script><asp:Content ContentPlaceHolderID="Contenido" runat="server"><h1>Informes</h1><div class="panel"><asp:DropDownList ID="opcion" runat="server" AutoPostBack="true"><asp:ListItem Value="0">Clientes registrados</asp:ListItem><asp:ListItem Value="1">Empleados activos</asp:ListItem><asp:ListItem Value="2">Servicios disponibles</asp:ListItem><asp:ListItem Value="3">Citas del día</asp:ListItem><asp:ListItem Value="4">Citas canceladas</asp:ListItem><asp:ListItem Value="5">Citas realizadas</asp:ListItem><asp:ListItem Value="6">Ingresos diarios</asp:ListItem><asp:ListItem Value="7">Ingresos mensuales</asp:ListItem><asp:ListItem Value="8">Servicios más solicitados</asp:ListItem><asp:ListItem Value="9">Productos con pocas existencias</asp:ListItem></asp:DropDownList><input type="search" placeholder="Buscar" oninput="document.querySelectorAll('table tr').forEach((r,i)=>{if(i)r.style.display=r.innerText.toLowerCase().includes(this.value.toLowerCase())?'':'none'})"/><button type="button" onclick="window.print()">Imprimir</button><asp:GridView ID="lista" runat="server" EmptyDataText="Sin registros"/></div></asp:Content>