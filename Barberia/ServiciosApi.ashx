<%@ WebHandler Language="C#" Class="ServiciosApi" %>
using System;using System.Web;using System.Web.SessionState;using System.Web.Script.Serialization;using System.Linq;
public class ServiciosApi:IHttpHandler,IRequiresSessionState{public bool IsReusable{get{return false;}}public void ProcessRequest(HttpContext c){c.Response.ContentType="application/json";if(!Datos.EsDueno()){c.Response.StatusCode=403;return;}var j=new JavaScriptSerializer();int id;int.TryParse(c.Request.QueryString["id"],out id);try{using(var db=new Contexto()){var item=id>0?db.Servicios.Find(id):null;switch(c.Request.HttpMethod){case "GET":if(id==0)c.Response.Write(j.Serialize(db.Servicios.ToList()));else if(item==null)c.Response.StatusCode=404;else c.Response.Write(j.Serialize(item));break;case "POST":case "PUT":var d=j.Deserialize<Servicio>(new System.IO.StreamReader(c.Request.InputStream).ReadToEnd());if(d==null||string.IsNullOrWhiteSpace(d.Nombre)||d.Precio<0||d.DuracionMin<=0){c.Response.StatusCode=400;return;}if(c.Request.HttpMethod=="POST"){d.Id=0;d.Descripcion=d.Descripcion??"";db.Servicios.Add(d);item=d;}else{if(item==null){c.Response.StatusCode=404;return;}item.Nombre=d.Nombre;item.Descripcion=d.Descripcion??"";item.Precio=d.Precio;item.DuracionMin=d.DuracionMin;item.Activo=d.Activo;}db.SaveChanges();c.Response.StatusCode=c.Request.HttpMethod=="POST"?201:200;c.Response.Write(j.Serialize(item));break;case "DELETE":if(item==null){c.Response.StatusCode=404;return;}db.Servicios.Remove(item);db.SaveChanges();c.Response.StatusCode=204;break;default:c.Response.StatusCode=405;break;}}}catch{c.Response.StatusCode=400;}}}