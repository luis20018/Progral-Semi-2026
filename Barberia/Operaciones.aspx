<%@ Page Language="C#" Inherits="PaginaBase" MasterPageFile="~/Site.master" %><%@ Import Namespace="System.Data" %><script runat="server">
string M {get {var m=Request.QueryString["m"];return m=="factura"||m=="pago"?m:"cita";}}
void Llenar(DropDownList d,string sql){d.DataSource=Datos.Tabla(sql);d.DataTextField="Texto";d.DataValueField="Id";d.DataBind();}
protected void Page_Load(object sender,EventArgs e){if(!Datos.EsDueno())throw new Exception("Acceso denegado");if(!IsPostBack){titulo.Text=M=="cita"?"Gestión integral de citas":M=="factura"?"Gestión integral de facturas":"Gestión integral de pagos"; Llenar(a,M=="cita"?"SELECT Id,Nombre+' '+Apellido Texto FROM Clientes WHERE Activo=1":M=="factura"?"SELECT Id,CONVERT(nvarchar,Id) Texto FROM Citas WHERE Estado='Realizada'":"SELECT Id,CONVERT(nvarchar,Id) Texto FROM Facturas");Llenar(b,M=="cita"?"SELECT Id,Nombre+' '+Apellido Texto FROM Empleados WHERE Activo=1":M=="factura"?"SELECT Id,Nombre Texto FROM Servicios WHERE Activo=1":"SELECT Id,Nombre Texto FROM MetodosPago");Llenar(serv,"SELECT Id,Nombre Texto FROM Servicios WHERE Activo=1"); la.Text=M=="cita"?"Cliente":M=="factura"?"Cita":"Factura";lb.Text=M=="cita"?"Empleado":M=="factura"?"Servicio":"Método de pago"; pc.Visible=M=="cita"; cantidad.Visible=M=="factura"; monto.Visible=M=="pago"; Cargar();}}
void Cargar(){grid.DataSource=Datos.Tabla(M=="cita"?"SELECT c.Id,c.Cliente,c.Empleado,c.Fecha,c.Hora,c.Estado,d.Servicio FROM Citas c LEFT JOIN DetalleCita d ON d.Cita=c.Id":M=="factura"?"SELECT f.Id,f.Cita,f.Fecha,d.Servicio,d.Cantidad,d.PrecioUnitario FROM Facturas f LEFT JOIN DetalleFactura d ON d.Factura=f.Id":"SELECT p.Id,p.Factura,p.Metodo,p.Monto,p.Fecha,cl.Nombre Cliente FROM Pagos p JOIN Facturas f ON f.Id=p.Factura JOIN Citas c ON c.Id=f.Cita JOIN Clientes cl ON cl.Id=c.Cliente");grid.DataBind();}
void Elegir(DropDownList d,object v){var i=d.Items.FindByValue(Convert.ToString(v));if(i!=null){d.ClearSelection();i.Selected=true;}}
protected void Seleccionar(object s,EventArgs e){try{int id=Convert.ToInt32(grid.SelectedDataKey.Value);var r=Datos.Tabla("SELECT * FROM "+(M=="cita"?"Citas":M=="factura"?"Facturas":"Pagos")+" WHERE Id=@id",Datos.P("@id",id)).Rows[0]; elegido.Value=id.ToString();fecha.Text=Convert.ToDateTime(r["Fecha"]).ToString("yyyy-MM-dd");Elegir(a,r[M=="cita"?"Cliente":M=="factura"?"Cita":"Factura"]);if(M=="cita"){Elegir(b,r["Empleado"]);hora.Text=((TimeSpan)r["Hora"]).ToString(@"hh\:mm");Elegir(estado,r["Estado"]);var d=Datos.Tabla("SELECT TOP 1 Servicio FROM DetalleCita WHERE Cita=@id",Datos.P("@id",id));if(d.Rows.Count>0)Elegir(serv,d.Rows[0][0]);}else if(M=="factura"){var d=Datos.Tabla("SELECT TOP 1 Servicio,Cantidad FROM DetalleFactura WHERE Factura=@id",Datos.P("@id",id));if(d.Rows.Count>0){Elegir(b,d.Rows[0][0]);cantidad.Text=d.Rows[0][1].ToString();}}else{Elegir(b,r["Metodo"]);monto.Text=r["Monto"].ToString();}}catch(Exception ex){msg.Text=Server.HtmlEncode(ex.Message);}}
protected void Guardar(object s,EventArgs e){try{int id;int.TryParse(elegido.Value,out id);int aa=int.Parse(a.SelectedValue),bb=int.Parse(b.SelectedValue);DateTime f=DateTime.Parse(fecha.Text);string sql;var args=new System.Collections.Generic.List<System.Data.SqlClient.SqlParameter>{Datos.P("@id",id),Datos.P("@a",aa),Datos.P("@b",bb),Datos.P("@f",f)};
if(M=="cita"){args.Add(Datos.P("@h",TimeSpan.Parse(hora.Text)));args.Add(Datos.P("@estado",estado.SelectedValue));args.Add(Datos.P("@s",int.Parse(serv.SelectedValue)));sql="IF EXISTS(SELECT 1 FROM Facturas WHERE Cita=@id) THROW 50001,'Cita facturada',1; IF @id=0 BEGIN INSERT INTO Citas(Cliente,Empleado,Fecha,Hora,Estado,Observaciones) VALUES(@a,@b,@f,@h,@estado,''); SET @id=SCOPE_IDENTITY(); END ELSE UPDATE Citas SET Cliente=@a,Empleado=@b,Fecha=@f,Hora=@h,Estado=@estado WHERE Id=@id; DELETE FROM DetalleCita WHERE Cita=@id; INSERT INTO DetalleCita(Cita,Servicio,Cantidad,PrecioUnitario) SELECT @id,Id,1,Precio FROM Servicios WHERE Id=@s AND Activo=1; IF @@ROWCOUNT=0 THROW 50001,'Servicio no disponible',1;";}
else if(M=="factura"){int q=int.Parse(cantidad.Text);if(q<=0)throw new Exception("Cantidad positiva requerida");args.Add(Datos.P("@q",q));sql="IF EXISTS(SELECT 1 FROM Pagos WHERE Factura=@id) THROW 50001,'Factura con pagos',1; IF NOT EXISTS(SELECT 1 FROM Citas WHERE Id=@a AND Estado='Realizada') THROW 50001,'Cita no realizada',1; IF @id=0 BEGIN INSERT INTO Facturas(Cita,Fecha) VALUES(@a,@f); SET @id=SCOPE_IDENTITY(); END ELSE UPDATE Facturas SET Cita=@a,Fecha=@f WHERE Id=@id; DELETE FROM DetalleFactura WHERE Factura=@id; INSERT INTO DetalleFactura(Factura,Servicio,Cantidad,PrecioUnitario) SELECT @id,Id,@q,Precio FROM Servicios WHERE Id=@b;";}
else{decimal v=decimal.Parse(monto.Text);if(v<=0)throw new Exception("Monto positivo requerido");args.Add(Datos.P("@v",v));sql="IF @v>ISNULL((SELECT SUM(Cantidad*PrecioUnitario) FROM DetalleFactura WHERE Factura=@a),0)-ISNULL((SELECT SUM(Monto) FROM Pagos WHERE Factura=@a AND Id<>@id),0) THROW 50001,'Monto superior al saldo',1; IF @id=0 INSERT INTO Pagos(Factura,Metodo,Monto,Fecha) VALUES(@a,@b,@v,@f); ELSE UPDATE Pagos SET Factura=@a,Metodo=@b,Monto=@v,Fecha=@f WHERE Id=@id;";}Datos.GuardarOperacion(sql,args.ToArray());elegido.Value="";Cargar();msg.Text="Guardado correctamente";}catch(Exception ex){msg.Text=Server.HtmlEncode(ex.Message);}}
protected void Eliminar(object s,EventArgs e){try{int id=int.Parse(elegido.Value);string sql=M=="cita"?"IF EXISTS(SELECT 1 FROM Facturas WHERE Cita=@id) THROW 50001,'Cita facturada',1; DELETE FROM Recordatorios WHERE Cita=@id; DELETE FROM DetalleCita WHERE Cita=@id; DELETE FROM Citas WHERE Id=@id;":M=="factura"?"IF EXISTS(SELECT 1 FROM Pagos WHERE Factura=@id) THROW 50001,'Factura con pagos',1; DELETE FROM DetalleFactura WHERE Factura=@id; DELETE FROM Facturas WHERE Id=@id;":"DELETE FROM Pagos WHERE Id=@id;";Datos.GuardarOperacion(sql,Datos.P("@id",id));elegido.Value="";Cargar();msg.Text="Eliminado";}catch(Exception ex){msg.Text=Server.HtmlEncode(ex.Message);}}
protected void Nuevo(object s,EventArgs e){Response.Redirect("Operaciones.aspx?m="+M);}
</script><asp:Content ContentPlaceHolderID="Contenido" runat="server"><h1><asp:Literal ID="titulo" runat="server"/></h1><div class="panel"><asp:HiddenField ID="elegido" runat="server"/><asp:Label ID="la" runat="server"/><asp:DropDownList ID="a" runat="server"/><asp:Label ID="lb" runat="server"/><asp:DropDownList ID="b" runat="server"/><label>Fecha</label><asp:TextBox ID="fecha" runat="server" TextMode="Date"/><asp:Panel ID="pc" runat="server"><label>Hora</label><asp:TextBox ID="hora" runat="server" TextMode="Time"/><label>Servicio</label><asp:DropDownList ID="serv" runat="server"/><label>Estado</label><asp:DropDownList ID="estado" runat="server"><asp:ListItem>Pendiente</asp:ListItem><asp:ListItem>Confirmada</asp:ListItem><asp:ListItem>Realizada</asp:ListItem><asp:ListItem>Cancelada</asp:ListItem></asp:DropDownList></asp:Panel><asp:TextBox ID="cantidad" runat="server" placeholder="Cantidad" Text="1"/><asp:TextBox ID="monto" runat="server" placeholder="Monto"/><asp:Button runat="server" Text="Nuevo" OnClick="Nuevo"/><asp:Button runat="server" Text="Guardar / modificar" OnClick="Guardar"/><asp:Button runat="server" Text="Eliminar" OnClick="Eliminar" OnClientClick="return confirm('¿Eliminar registro?');"/><asp:Label ID="msg" runat="server"/></div><div class="panel"><input type="search" placeholder="Buscar registros" oninput="document.querySelectorAll('table tr').forEach((r,i)=>{if(i)r.style.display=r.innerText.toLowerCase().includes(this.value.toLowerCase())?'':'none'})"/><asp:GridView ID="grid" runat="server" DataKeyNames="Id" AutoGenerateSelectButton="true" OnSelectedIndexChanged="Seleccionar" EmptyDataText="Sin registros"/></div></asp:Content>